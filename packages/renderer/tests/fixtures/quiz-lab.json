{
  "schemaVersion": 1,
  "id": "quiz-renderer-fixture",
  "title": "Quiz Renderer Fixture Lab",
  "repo": "ramplab/ramplab",
  "base": {
    "modules": [
      {
        "id": "parsing-module",
        "title": "Spec Parsing",
        "widgets": [
          {
            "id": "parsing-checkpoint",
            "type": "quiz",
            "title": "Checkpoint: parsing",
            "questions": [
              {
                "id": "unknown-version",
                "prompt": "A spec arrives with schemaVersion 99. What does safeParseLabSpec do?",
                "options": [
                  {
                    "id": "rejects-early",
                    "label": "Rejects it before schema validation even runs"
                  },
                  {
                    "id": "coerces",
                    "label": "Coerces it down to version 1"
                  },
                  {
                    "id": "throws",
                    "label": "Throws a LabSpecParseError"
                  }
                ],
                "correctOptionId": "rejects-early",
                "explanation": {
                  "body": "The version gate runs first, so old parsers never half-validate a newer spec.",
                  "anchors": [
                    {
                      "file": "packages/spec/src/parse.ts",
                      "symbol": "safeParseLabSpec"
                    }
                  ]
                }
              },
              {
                "id": "unanchored-callout",
                "prompt": "A machine-generated callout carries zero anchors. What happens?",
                "options": [
                  {
                    "id": "schema-rejects",
                    "label": "Schema validation fails — grounding is structural"
                  },
                  {
                    "id": "renders-anyway",
                    "label": "It renders with a warning badge"
                  }
                ],
                "correctOptionId": "schema-rejects",
                "explanation": {
                  "body": "Anchors are a structural requirement on machine content, not a convention.",
                  "anchors": [
                    {
                      "file": "packages/spec/src/schema.ts",
                      "symbol": "calloutWidgetSchema"
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      {
        "id": "quizless-module",
        "title": "No Checkpoints Here",
        "widgets": [
          {
            "id": "plain-callout",
            "type": "callout",
            "kind": "why",
            "body": "A module without checkpoints is never marked complete.",
            "anchors": [
              {
                "file": "packages/renderer/src/progress.ts",
                "symbol": "isModuleComplete"
              }
            ]
          }
        ]
      }
    ]
  },
  "overlay": []
}
