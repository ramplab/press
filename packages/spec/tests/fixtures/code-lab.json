            "code": [
              "export function safeParseLabSpec(input) {",
              "  if (typeof input !== 'object') return reject(input);",
              "  const version = input.schemaVersion;",
              "  if (version !== SCHEMA_VERSION) return unsupported(version);",
              "  return labSpecSchema.safeParse(input);",
              "}"
            ],
            "steps": [
              {
                "lines": { "start": 1, "end": 2 },
                "commentary": {
                  "body": "Non-objects are rejected before Zod ever runs.",
                  "anchors": [
